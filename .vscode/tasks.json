{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "func: host start",
      "type": "shell",
      "command": "uv run --locked func host start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": "uv sync (functions)",
      "problemMatcher": "$func-python-watch",
      "isBackground": true
    },
    {
      "label": "uv sync (functions)",
      "type": "shell",
      "command": "uv sync --locked",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    }
  ]
}