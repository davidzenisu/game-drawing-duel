{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Python Functions",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9091
      },
      "preLaunchTask": "uv: func host start"
    },
    {
      "name": "Flutter: Frontend (Codespaces)",
      "type": "dart",
      "request": "launch",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}/frontend",
      "deviceId": "web-server",
      "toolArgs": [
        "--web-hostname=0.0.0.0",
        "--web-port=8080"
      ]
    }
  ]
}